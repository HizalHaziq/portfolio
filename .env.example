# Portfolio environment configuration — copy to .env and adjust.
# Everything is optional; the site runs with sensible defaults.

# PORT=3000
# NODE_ENV=production
# SITE_URL=https://your-domain.com

# --- GitHub live data ---
# GITHUB_USERNAME=HizalHaziq
# Optional personal access token (raises rate limit 60 → 5000 req/h). Server-side only.
# GITHUB_TOKEN=

# --- Blog (Dev.to) — set to activate the articles section ---
# DEVTO_USERNAME=

# --- Contact ---
# CONTACT_EMAIL=you@example.com
# Optional Formspree endpoint to mirror contact submissions:
# FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxx

# --- Security ---
# Random string used to salt privacy hashes (visitor counter, rate-limit keys).
# VISIT_SALT=change-me-to-a-long-random-string
# Set true when running behind a reverse proxy (Vercel/Nginx/Cloudflare).
# TRUST_PROXY=false
