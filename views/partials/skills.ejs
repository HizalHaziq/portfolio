<section class="section section-alt" id="skills" aria-labelledby="skills-title">
  <div class="container">
    <header class="section-head reveal">
      <p class="kicker"><span class="kicker-num">02</span> Skills</p>
      <h2 class="section-title" id="skills-title">Tools I build with</h2>
      <p class="section-sub">Grouped by category — hover or focus a card for details. Levels are honest, not decorative.</p>
    </header>

    <div class="skills-toolbar reveal" role="group" aria-label="Skill categories">
      <button class="chip chip-filter" type="button" data-skill-filter="all" aria-pressed="true">All</button>
      <% d.skillCategories.forEach(function (cat) { %>
        <button class="chip chip-filter" type="button" data-skill-filter="<%= cat.id %>" aria-pressed="false">
          <%- ic(cat.icon) %><%= cat.label %>
        </button>
      <% }); %>
    </div>

    <div class="skills-grid" id="skills-grid" aria-live="polite">
      <% d.skills.forEach(function (s) { %>
        <article class="skill-card reveal" data-category="<%= s.category %>" tabindex="0"
                 aria-describedby="skill-tip-<%= s.name.replace(/[^a-z0-9]/gi, '-') %>">
          <div class="skill-head">
            <span class="skill-name"><%= s.name %></span>
            <% if (s.learning) { %><span class="badge badge-learning"><%- ic('sparkles') %> learning</span><% } %>
          </div>
          <div class="skill-level" role="img" aria-label="Level: <%= s.levelLabel %> ( <%= s.level %> of 5 )">
            <span class="level-segs" aria-hidden="true">
              <% for (let i = 1; i <= 5; i++) { %><i class="level-seg <%= i <= s.level ? 'on' : '' %>"></i><% } %>
            </span>
            <span class="level-label"><%= s.levelLabel %></span>
          </div>
          <div class="skill-tip" id="skill-tip-<%= s.name.replace(/[^a-z0-9]/gi, '-') %>" role="tooltip">
            <strong><%= s.name %></strong> — <%= s.description %>
            <span class="skill-status"><%- ic('clock') %> <%= s.status %></span>
          </div>
        </article>
      <% }); %>
    </div>
    <p class="empty-note" id="skills-empty" hidden>No skills in this category.</p>
  </div>
</section>
